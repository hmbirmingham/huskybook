# Copy this to .env and fill in real values. Never commit .env itself,
# it's already gitignored.
#
# None of these are required for local dev: without them, the app runs
# exactly as documented in the README (mailer logs sign-in links to the
# console; the database is a local file instead of a hosted one). They
# matter once NODE_ENV=production.

# Required in production
NODE_ENV=production
RESEND_API_KEY=                    # from resend.com, email delivery for magic links
BASE_URL=                          # the app's own public URL, no trailing slash
                                    # (e.g. https://huskybook.onrender.com)

# Required in production for the database to persist across
# restarts/redeploys. Without these, the app falls back to a local
# SQLite file, which most free hosts (this one included) don't keep
# around between deploys.
TURSO_DATABASE_URL=                # from turso.tech, looks like libsql://<name>.turso.io
TURSO_AUTH_TOKEN=                  # from the same Turso database

# This file lists only the variables the running code actually reads.
# See BUILD_LOG.md for how each one came to exist.
