# Copy this to .env and fill in real values. Never commit .env itself —
# it's already gitignored.
#
# None of these are required for local dev: without them, the app runs
# exactly as documented in the README (mailer logs sign-in links to the
# console instead of emailing them). They matter once NODE_ENV=production.

# Required in production
NODE_ENV=production
RESEND_API_KEY=                    # from resend.com — email delivery for magic links
BASE_URL=                          # the app's own public URL, no trailing slash
                                    # (e.g. https://huskybook.up.railway.app)

# More variables will be added here as later features land (see
# BUILD_LOG.md and dev-notes/handoffs/ for what's in progress) — this
# file should only ever list variables the running code actually reads.
